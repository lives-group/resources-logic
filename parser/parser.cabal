cabal-version:       >=1.10
-- Initial package description 'parser.cabal' generated by 'cabal init'.
-- For further documentation, see http://haskell.org/cabal/users-guide/

name:                parser
version:             0.1.0.0
-- synopsis:
-- description:
-- bug-reports:
-- license:
license-file:        LICENSE
author:              SaldanhaGA
maintainer:          gabrielsaldanha373@gmail.com
-- copyright:
-- category:
build-type:          Simple
extra-source-files:  CHANGELOG.md
                   , src/Syntax/specification.md

executable parser
  main-is:             Main.hs

  other-modules:
    Lexer.Lexer
    , Syntax.Syntax
    , Parser.Parser
  
  build-tool-depends:  alex:alex 
  
  build-depends:
      base >=4.13 && <5
    , optparse-applicative
    , megaparsec
    , parser-combinators
    , array
  
  hs-source-dirs:      app, src
  default-language:    Haskell2010

test-suite parser-test
    type:              exitcode-stdio-1.0
    main-is:           Spec.hs
    build-depends:
        base >=4.13 && <5
      , QuickCheck
    hs-source-dirs:    test
    default-language:  Haskell2010
